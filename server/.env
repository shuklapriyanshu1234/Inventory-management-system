# Application Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:4000

# Database Configuration
# Default: SQLite file for seamless zero-config local run
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker / Production):
# DATABASE_URL="postgresql://xyz_user:xyz_password@localhost:5432/xyz_inventory?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="xyz-super-secret-jwt-access-key-minimum-32-chars-long"
JWT_REFRESH_SECRET="xyz-super-secret-jwt-refresh-key-minimum-32-chars-long"
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Uploads Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
